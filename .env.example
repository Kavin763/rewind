# Copy this file to .env and fill in your Groq key: https://console.groq.com/keys

# Used by Rewind's agent AND by the Hindsight container (docker-compose.yml)
GROQ_API_KEY=gsk_your_key_here

# Model Rewind uses for triage (Groq model ids)
LLM_MODEL=openai/gpt-oss-120b
LLM_FALLBACK_MODEL=qwen/qwen3-32b

# Model Hindsight uses internally for fact extraction (smaller and faster is fine)
HINDSIGHT_LLM_MODEL=openai/gpt-oss-20b

# Hindsight connection
HINDSIGHT_URL=http://localhost:8888
HINDSIGHT_BANK_ID=rewind-oncall
# HINDSIGHT_API_KEY=            # only if your Hindsight server requires a token

# Recall tuning
RECALL_MAX_TOKENS=2048
RECALL_BUDGET=mid

# Queue memory writes in Hindsight's background worker (recommended on free Groq tiers)
RETAIN_ASYNC=true
